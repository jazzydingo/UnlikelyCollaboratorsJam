    - target: {fileID: 2972669776187795483, guid: cf18eb76bda2e504db14e0d89aeb829c, type: 3}
      propertyPath: startDialogue
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 2972669776187795483, guid: cf18eb76bda2e504db14e0d89aeb829c, type: 3}
      propertyPath: dialogueLines.Array.size
      value: 8
      objectReference: {fileID: 0}
    - target: {fileID: 2972669776187795483, guid: cf18eb76bda2e504db14e0d89aeb829c, type: 3}
      propertyPath: dialogueLines.Array.data[0]
      value: 'Leo wakes up from the pressure of his cat on his chest. '
      objectReference: {fileID: 0}
    - target: {fileID: 2972669776187795483, guid: cf18eb76bda2e504db14e0d89aeb829c, type: 3}
      propertyPath: dialogueLines.Array.data[1]
      value: 'He looks around. The room is still dark. '
      objectReference: {fileID: 0}
    - target: {fileID: 2972669776187795483, guid: cf18eb76bda2e504db14e0d89aeb829c, type: 3}
      propertyPath: dialogueLines.Array.data[2]
      value: 'The clock reads 3:00 AM. '
      objectReference: {fileID: 0}
    - target: {fileID: 2972669776187795483, guid: cf18eb76bda2e504db14e0d89aeb829c, type: 3}
      propertyPath: dialogueLines.Array.data[3]
      value: "Silky: \"Mom is really mad at you.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 2972669776187795483, guid: cf18eb76bda2e504db14e0d89aeb829c, type: 3}
      propertyPath: dialogueLines.Array.data[4]
      value: "Silky: \u201CI\u2019m sorry for leaving all of your toys out and making
        a mess.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 2972669776187795483, guid: cf18eb76bda2e504db14e0d89aeb829c, type: 3}
      propertyPath: dialogueLines.Array.data[5]
      value: 'Silky: "... and also for ripping the note up..."'
      objectReference: {fileID: 0}
    - target: {fileID: 2972669776187795483, guid: cf18eb76bda2e504db14e0d89aeb829c, type: 3}
      propertyPath: dialogueLines.Array.data[6]
      value: 'Silky: "But in my defense, it was very crinkly! and it was not something
        you needed to read..."'
      objectReference: {fileID: 0}
    - target: {fileID: 2972669776187795483, guid: cf18eb76bda2e504db14e0d89aeb829c, type: 3}
      propertyPath: dialogueLines.Array.data[7]
      value: 'Use your light to look for clues. Press ''Space'' to collect or interact
        with objects near you. '
      objectReference: {fileID: 0}
